{
  "name": "private-messaging",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "nodemon ./server",
    "dev:server": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "vite build",
